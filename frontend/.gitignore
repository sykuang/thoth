/android

# iOS build artifacts (generated by prebuild + xcodebuild + pod install)
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/.xcode.env.local
*.hmap
DerivedData/

# logs
*.log
