{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Thoth",
  "version": "0.1.0",
  "identifier": "com.thoth.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "pnpm expo start --web --port 8081",
    "beforeBuildCommand": "pnpm expo export -p web"
  },
  "app": {
    "windows": [
      {
        "title": "Thoth",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Personal Finance Aggregator",
    "longDescription": "Thoth — 個人記帳儀表板（仿 MoneyBook，多家台灣銀行 + 信用卡聚合）"
  }
}
