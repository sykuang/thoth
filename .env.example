# =============================================================================
# Thoth — Environment variables template
# =============================================================================
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#     # then edit .env
#
# `.env` is git-ignored — never commit real credentials.
#
# Recommended setup for new users:
#   1. Generate SERVER_FERNET_KEY + JWT_SECRET (see commands below)
#   2. Start backend, register a user via web/iOS app
#   3. Add bank credentials via the Settings page (encrypted with Fernet, stored in DB)
#   4. Bank-specific env vars below are LEGACY (used by CLI / probe tools only)
#      — multi-user web/iOS app does NOT read them; it uses per-account DB credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Required: server secrets
# -----------------------------------------------------------------------------

# JWT signing secret — used to sign / verify auth tokens.
# Rotation policy: SAFE to rotate any time (all existing sessions invalidate, users re-login).
# Generate:   openssl rand -hex 32
JWT_SECRET=

# Fernet symmetric encryption key — encrypts bank credentials at rest in SQLite.
# Rotation policy: DO NOT rotate after credentials are saved — will brick the DB
# (all encrypted ciphertexts become unreadable). Use a stable key per environment.
# Generate:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SERVER_FERNET_KEY=

# SnapTrade Commercial API credentials — optional; enables the read-only
# investment connection flow. Keep both server-side only.
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=


# -----------------------------------------------------------------------------
# Optional: server-level X-API-Key (defense-in-depth)
# -----------------------------------------------------------------------------
# When set, every API request must include `X-API-Key: <value>` header
# (or `?api_key=<value>` query string). The /healthz endpoint and CORS preflight
# OPTIONS requests are exempt. Frontend has a settings field for users to paste this.
# When unset, the API key middleware is no-op (suitable for local dev).
#
# Generate:   openssl rand -hex 32
# SERVER_API_KEY=


# -----------------------------------------------------------------------------
# Optional: login rate limiting (defaults shown)
# -----------------------------------------------------------------------------
# Per-IP failed login threshold before temporary lockout. Locks the IP (not the
# account) to prevent attackers from DoS-locking real users with known emails.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=1800   # 30 minutes


# -----------------------------------------------------------------------------
# Optional: data root + CORS
# -----------------------------------------------------------------------------
# Where SQLite DBs are stored (default: backend/data/ relative to project root).
# BANK_DATA_ROOT=/path/to/data

# Comma-separated list of allowed CORS origins (production).
# When unset, dev default allows http(s)://localhost / 127.0.0.1 on any port.
# CORS_ORIGINS=https://your-frontend.example.com,https://another.example.com


# -----------------------------------------------------------------------------
# Legacy: per-bank credentials (CLI / probe tools only)
# -----------------------------------------------------------------------------
# These are used by:
#   - The CLI runner (cli/cli.py sync <bank>) when invoked WITHOUT
#     BANK_CRAWLER_ACCOUNT_ID or BANK_CRAWLER_USER_ID
#   - The probe tools under backend/tools/probe_*.py
#
# In the multi-user web/iOS app, credentials are stored per-account in SQLite
# (Fernet-encrypted) and these env vars are NOT consulted. See:
#   backend/server/routers/accounts.py — PUT /accounts/{id}/fields endpoint
#
# Bank Cathay (國泰世華 — myb.cathaybk.com.tw)
# CATHAY_CUST_ID=          # 國民身分證字號 (10 chars)
# CATHAY_USER_ID=          # 用戶代號
# CATHAY_PASSWORD=

# Bank CTBC (中國信託)
# CTBC_NATIONAL_ID=        # 身分證字號
# CTBC_USER_CODE=          # 用戶代號 (可短至 4 碼)
# CTBC_PASSWORD=

# Bank E.SUN (玉山)
# ESUN_NATIONAL_ID=
# ESUN_USER_CODE=
# ESUN_PASSWORD=

# Bank Fubon (富邦)
# FUBON_NATIONAL_ID=
# FUBON_USER_CODE=
# FUBON_PASSWORD=

# Bank HSBC (匯豐)
# HSBC_USER_ID=
# HSBC_PASSWORD=

# Bank Sinopac (永豐)
# SINOPAC_NATIONAL_ID=
# SINOPAC_USER_CODE=
# SINOPAC_PASSWORD=

# Bank UBOT (聯邦)
# UBOT_NATIONAL_ID=
# UBOT_USER_CODE=
# UBOT_PASSWORD=

# Bank Taishin (台新) — note: no env vars exposed; uses DB credentials only
# (taishin requires multi-step popup handling, see backend/banks/taishin.py)

# Bank DBS (星展台灣)
# DBS_USERNAME=
# DBS_PASSWORD=

# Bank SCB (渣打台灣)
# SCB_USERNAME=
# SCB_NATIONAL_ID=
# SCB_PASSWORD=

# Bank SCSB (上海商銀)
# SCSB_USER_CODE=
# SCSB_NATIONAL_ID=
# SCSB_PASSWORD=

# Bank LINE Bank (連線商業銀行) — note: no env vars; uses DB credentials only

