# === thoth server runtime secrets ===
# Copy this to backend/server/.env, mode 0600
# Server-mode start: ".venv/bin/python -m uvicorn backend.server.app:app"
#
# JWT_SECRET — JWT 簽章 secret
# 產一把: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# 換 key 後所有 user 既有 token 失效, 全部要重登
JWT_SECRET=

# SERVER_FERNET_KEY — Fernet 對稱加密 master key (加解密 sqlite 銀行帳密)
# 產一把: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# ⚠️ 換 key 必跑 migration script 用舊 key 解 → 新 key 重加密, 不然所有 cred 全廢
SERVER_FERNET_KEY=

# CORS_ORIGINS, SERVER_API_KEY, LOGIN_MAX_FAILURES, LOGIN_LOCKOUT_SECONDS — optional
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.6:8081
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900

# BANK_DATA_ROOT (optional) — sqlite 寫入目錄, 預設 backend/data
# 只在要 override module default (例如 docker mount) 才需設
# BANK_DATA_ROOT=/custom/path/to/data
