# === thoth CLI / MCP / probe bank credentials ===
# Copy this to cli/.env, mode 0600
# 用於 maintainer CLI dry-run；server mode 使用加密資料庫，不讀本檔
#
# 11 家銀行帳密 (env 變數命名 = {BANK}_{FIELD_UPPER} - 詳 backend/core/creds.py)

# Cathay 國泰世華 MyBank
CATHAY_CUST_ID=
CATHAY_USER_ID=
CATHAY_PASSWORD=

# UBot 聯邦
UBOT_NATIONAL_ID=
UBOT_USER_CODE=
UBOT_PASSWORD=

# HSBC 匯豐 (信用卡網銀, 兩段式)
HSBC_USER_ID=
HSBC_PASSWORD=

# CTBC 中信
CTBC_NATIONAL_ID=
CTBC_USER_CODE=
CTBC_PASSWORD=

# SCSB 上海商銀 iBank
SCSB_NATIONAL_ID=
SCSB_USER_CODE=
SCSB_PASSWORD=

# Sinopac 永豐 MMA
SINOPAC_NATIONAL_ID=
SINOPAC_USER_CODE=
SINOPAC_PASSWORD=

# Esun 玉山
ESUN_NATIONAL_ID=
ESUN_USER_CODE=
ESUN_PASSWORD=

# Taishin 台新 (新加, 2026-06-14 起)
TAISHIN_NATIONAL_ID=
TAISHIN_USER_CODE=
TAISHIN_PASSWORD=

# Fubon 台北富邦
FUBON_NATIONAL_ID=
FUBON_USER_CODE=
FUBON_PASSWORD=

# DBS 星展 (兩欄, 無身分證無 captcha)
DBS_USERNAME=
DBS_PASSWORD=

# SCB 渣打 (3 欄帳密 + captcha)
SCB_NATIONAL_ID=
SCB_USERNAME=
SCB_PASSWORD=

# LineBank 將來銀行 (3 欄, 2026-06-14 起)
LINEBANK_NATIONAL_ID=
LINEBANK_USER_CODE=
LINEBANK_PASSWORD=

# BANK_DATA_ROOT (optional) — sqlite 寫入目錄, 預設 backend/data
# 只在要 override module default (例如 docker mount) 才需設
# BANK_DATA_ROOT=/custom/path/to/data
